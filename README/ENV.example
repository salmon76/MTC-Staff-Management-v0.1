# =================================================================
# MTC Staff Management System - Environment Configuration Blueprint
# =================================================================

# =========================
# Application Environment
# =========================
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_BASE_URL=https://mtc-staff-management-v1.vercel.app

# =========================
# Supabase PostgreSQL Database (Prisma ORM)
# =========================
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transaction Pooler connection URL for Prisma client queries
DATABASE_URL=postgresql://postgres.xxxx:your-password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct Connection URL for Prisma migrations & DDL schema sync
DIRECT_URL=postgresql://postgres.xxxx:your-password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# =========================
# LINE Messaging API & Bot Webhook
# =========================
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# =========================
# LINE LIFF (Web App Gateway)
# =========================
NEXT_PUBLIC_LIFF_ID=your-line-liff-id

# =========================
# SLA Monitoring Cron Security Secret
# =========================
CRON_SECRET=your-secure-cron-secret-key
